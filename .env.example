AuthClientId=kanban_sim
AuthClientSecret=client_secret

AuthAuthority=https://my.web.site
AuthCallbackUrl=/auth/signin-oidc

BASE_URL=http://localhost
SESSION_SECRET_KEY=change-me-to-a-random-value
SESSION_COOKIE_SECURE=false

# AI agent (optional). Defaults: RouterAI (OpenAI-compatible) + OpenAI GPT-4.1 nano (fast, cheap).
# With AGENT_DEFAULT_API_KEY set, users can start runs without entering a key;
# it is only ever sent to AGENT_DEFAULT_BASE_URL. Get a key at https://routerai.ru
AGENT_DEFAULT_BASE_URL=https://routerai.ru/api/v1
AGENT_DEFAULT_MODEL=openai/gpt-4.1-nano
AGENT_DEFAULT_API_KEY=

# Agent runs are background server tasks: users may close the page while one plays.
# Per-request model timeout (s), retries of a failed day (with backoff), whole-run cap (min).
AGENT_LLM_TIMEOUT_SECONDS=120
AGENT_LLM_RETRIES=4
AGENT_MAX_RUN_MINUTES=120
# Context window of the model (tokens). Older days are summarized once the context
# passes THRESHOLD x WINDOW (lower = cheaper runs, shorter verbatim memory).
AGENT_CONTEXT_WINDOW_TOKENS=200000
AGENT_CONTEXT_SUMMARY_THRESHOLD=0.3
