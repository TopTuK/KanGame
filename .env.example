AuthClientId=kanban_sim
AuthClientSecret=client_secret

AuthAuthority=https://my.web.site
AuthCallbackUrl=/auth/signin-oidc

BASE_URL=http://localhost
SESSION_SECRET_KEY=change-me-to-a-random-value
SESSION_COOKIE_SECURE=false

# AI agent (optional). Defaults: OpenRouter + OpenAI GPT-6 Luna (fast, cheap).
# With AGENT_DEFAULT_API_KEY set, users can start runs without entering a key;
# it is only ever sent to AGENT_DEFAULT_BASE_URL. Get a key at https://openrouter.ai/keys
AGENT_DEFAULT_BASE_URL=https://openrouter.ai/api/v1
AGENT_DEFAULT_MODEL=openai/gpt-6-luna
AGENT_DEFAULT_API_KEY=
